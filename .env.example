# 本地开发与联调示例。复制为 .env 后请勿提交真实凭据。

# Public ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Local PowerShell mode uses SQLite by default.
DATABASE_URL=sqlite+pysqlite:///./yujian.db

# Docker Compose PostgreSQL credentials (demo only; change outside local demo).
POSTGRES_DB=yujian
POSTGRES_USER=yujian
POSTGRES_PASSWORD=yujian_demo_change_me

# FastAPI demo settings
ENVIRONMENT=demo
SEED_DEMO_DATA=true
SCENARIO_TICK_SECONDS=2
EVENT_STREAM_KEEPALIVE_SECONDS=15
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# HttpOnly cookie authentication. Local/demo/test environments may omit the
# password and use the built-in local fallback. Production must set a unique
# strong password and AUTH_SECURE_COOKIE=true.
AUTH_COOKIE_NAME=yujian_session
AUTH_COOKIE_SAMESITE=lax
AUTH_SECURE_COOKIE=false
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=30
AUTH_PBKDF2_ITERATIONS=310000
AUTH_DEFAULT_TENANT_ID=demo-tenant
AUTH_SEED_ADMIN_USERNAME=admin
# AUTH_SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-password
AUTH_SEED_ADMIN_DISPLAY_NAME=王海峰
AUTH_SEED_ADMIN_ROLE=防汛值班长

# Frontend API base. The auth client sends cookies with every request.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
