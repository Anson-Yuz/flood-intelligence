# 本地开发与联调示例。复制为 .env 后请勿提交真实凭据。
ENVIRONMENT=development

# Default is server/yujian.db. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://yujian:password@127.0.0.1:5432/yujian
DATABASE_URL=sqlite+pysqlite:///./yujian.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SEED_DEMO_DATA=true
SCENARIO_TICK_SECONDS=2.0

# Authentication. In development/demo/test only, omitting
# AUTH_SEED_ADMIN_PASSWORD enables the local fallback password Yujian@2026.
AUTH_COOKIE_NAME=yujian_session
AUTH_COOKIE_SAMESITE=lax
AUTH_SECURE_COOKIE=false
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=30
AUTH_PBKDF2_ITERATIONS=310000
AUTH_DEFAULT_TENANT_ID=demo-tenant
AUTH_SEED_ADMIN_USERNAME=admin
# AUTH_SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-password
AUTH_SEED_ADMIN_DISPLAY_NAME=王海峰
AUTH_SEED_ADMIN_ROLE=防汛值班长
